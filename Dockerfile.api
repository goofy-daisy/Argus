FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi==0.136.3 \
    uvicorn==0.48.0 \
    sqlalchemy==2.0.50 \
    alembic==1.18.4 \
    psycopg2-binary==2.9.12

COPY argus/ ./argus/
COPY config.yaml .

EXPOSE 8000

CMD ["uvicorn", "argus.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
