# Argus environment variables — copy to .env and fill in values

# JWT secret — change this in production
JWT_SECRET=argus-dev-secret-key-change-in-production

# PostgreSQL
DATABASE_URL=postgresql://localhost:5432/argus

# MLflow
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_ALLOW_FILE_STORE=true

# Apple Silicon — required for X3D-S on MPS
PYTORCH_ENABLE_MPS_FALLBACK=1

# Frontend API URL (default: localhost:8000)
REACT_APP_API_URL=http://localhost:8000
